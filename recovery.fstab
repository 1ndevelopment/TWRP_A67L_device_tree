# Recovery fstab for FOXXD A67L (SC9863A)
# Android 14 (API 34), A/B slots, Dynamic partitions, EROFS
# Generated from stock fstab.s9863a1h10 and live device partition list

# Boot partitions (physical, slot-specific)
/boot           emmc    /dev/block/by-name/boot           slotselect
/vendor_boot    emmc    /dev/block/by-name/vendor_boot    slotselect
/init_boot      emmc    /dev/block/by-name/init_boot      slotselect
/dtbo           emmc    /dev/block/by-name/dtbo           slotselect

# VBMeta partitions (physical, slot-specific)
/vbmeta         emmc    /dev/block/by-name/vbmeta         slotselect
/vbmeta_vendor  emmc    /dev/block/by-name/vbmeta_vendor  slotselect
/vbmeta_system  emmc    /dev/block/by-name/vbmeta_system  slotselect
/vbmeta_odm     emmc    /dev/block/by-name/vbmeta_odm     slotselect
/vbmeta_product       emmc    /dev/block/by-name/vbmeta_product       slotselect
/vbmeta_system_ext    emmc    /dev/block/by-name/vbmeta_system_ext    slotselect

# Dynamic/logical partitions (mapped from super by TWRP)
/system         erofs   /dev/block/mapper/system          defaults
/vendor         erofs   /dev/block/mapper/vendor          defaults
/product        erofs   /dev/block/mapper/product         defaults
/system_ext     erofs   /dev/block/mapper/system_ext      defaults
/odm            erofs   /dev/block/mapper/odm             defaults
/vendor_dlkm    erofs   /dev/block/mapper/vendor_dlkm     defaults
/system_dlkm    erofs   /dev/block/mapper/system_dlkm     defaults

# Data and cache (physical, shared between slots)
/data           f2fs    /dev/block/by-name/userdata       defaults
/cache          ext4    /dev/block/by-name/cache          defaults
/metadata       ext4    /dev/block/by-name/metadata       defaults

# Misc partitions
/misc           emmc    /dev/block/by-name/misc           defaults
/persist        emmc    /dev/block/by-name/persist        defaults
/prodnv         ext4    /dev/block/by-name/prodnv         defaults
/blackbox       ext4    /dev/block/by-name/blackbox       defaults
/super          emmc    /dev/block/by-name/super          slotselect
